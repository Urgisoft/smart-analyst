		{"id":"ch-btruns","type":"text","text":"**bt_runs · bt_runs_regime · bt_trades**\nBacktest results per (strategy, param, ticker, interval).","x":-850,"y":160,"width":420,"height":120,"color":"5"},
		{"id":"ch-allow","type":"text","text":"**cell_allowlist**\nPromoted (strategy, param, ticker) cells per bundle.\nGate-1 source of truth.","x":-850,"y":300,"width":420,"height":120,"color":"5"},
		{"id":"ch-paper","type":"text","text":"**paper_trading_positions · daemon_runs**\nLive book + run log.","x":-850,"y":440,"width":420,"height":100,"color":"5"},
		{"id":"lyr-eng","type":"text","text":"## ⚙️ Engines","x":-300,"y":-440,"width":420,"height":50,"color":"4"},
		{"id":"eng-bt","type":"text","text":"**Backtest engine**\n`batch_backtest.ts` + workers.\nSweeps strategy × param × ticker × interval.\nWalk-forward OOS (split-pct 70).\n→ [[03 - Backtest Engine]]","x":-300,"y":-360,"width":420,"height":160,"color":"4"},
		{"id":"eng-score","type":"text","text":"**Scoring & overfit correction**\nDeflated Sharpe (Bailey-LdP), PBO via CSCV,\nHLZ multiple-testing haircut.\n`src/lib/psr.ts · cscv.ts · hlzHaircut.ts`","x":-300,"y":-180,"width":420,"height":140,"color":"4"},
		{"id":"eng-allow","type":"text","text":"**Allowlist promotion**\n`populate_cell_allowlist.ts` — picks cells with\nDSR ≥ threshold, PBO ≤ threshold, ≥N OOS trades.","x":-300,"y":-20,"width":420,"height":120,"color":"4"},
		{"id":"eng-regime","type":"text","text":"**Regime classifier v3**\n`src/server/macro_regime_v3.ts`\n6 categories: yield_curve · credit_stress · risk_off_rotation\n· sentiment_extreme · vix_term_inverted · hyg_spy_divergence\n→ [[04 - Regime Classifier (phase1_v3)]]","x":-300,"y":120,"width":420,"height":220,"color":"4"},
		{"id":"lyr-gate","type":"text","text":"## 🚦 Trade execution pipeline","x":250,"y":-440,"width":420,"height":50,"color":"2"},
		{"id":"g1","type":"text","text":"**GATE 1 — Allowlist**\nCH lookup in `cell_allowlist`. <1ms.\n✅ LIVE (session 38).","x":250,"y":-360,"width":420,"height":120,"color":"2"},
		{"id":"g2","type":"text","text":"**GATE 2 — Regime conditional**\nToday's `macro_regimes` row vs bundle's regime cond.\n✅ LIVE (phase1_v3, session 42).","x":250,"y":-220,"width":420,"height":120,"color":"2"},
		{"id":"g3","type":"text","text":"**GATE 3 — ML probability (meta-labeling)**\nPer (strategy, param) classifier — TP-before-SL prob.\n⏸ DEFERRED ≥4 wk (ADR-027 lift -1.07pp).","x":250,"y":-80,"width":420,"height":140,"color":"3"},
		{"id":"g4","type":"text","text":"**GATE 4 — LLM validator (Claude API)**\nQualitative exclusion only — earnings, halts, news.\n⏸ DEFERRED.","x":250,"y":80,"width":420,"height":140,"color":"3"},
		{"id":"g-out","type":"text","text":"→ **Position open** (paper)\nLogged to `paper_trading_positions`.","x":250,"y":240,"width":420,"height":100,"color":"4"},
		{"id":"lyr-dae","type":"text","text":"## 🤖 Daemon — daily cadence","x":800,"y":-440,"width":420,"height":50,"color":"4"},
		{"id":"dae","type":"text","text":"**daily_signal_daemon.ts** (`npm run daemon:daily`)\n\n1. `[macro-fetch]` — refresh macro candles (VIX/HYG/SPY…)\n2. `[macro-classify-v3]` — write today's regime row\n3. Iterate cells × allowlist → primary signal\n4. Apply Gates 1+2 (3+4 deferred)\n5. Emit positions + Telegram alert\n6. Persist to `daemon_runs`\n→ [[06 - Daemon (daily cadence)]]","x":800,"y":-360,"width":420,"height":340,"color":"4"},
		{"id":"lyr-ops","type":"text","text":"## 🛡️ Paper trading & monitoring","x":800,"y":40,"width":420,"height":50,"color":"3"},
		{"id":"ops-track","type":"text","text":"**Track A — paper-trading shakedown**\nDay 3 of 30 (as of 2026-05-16).\nA4/A5 verdicts flip ~2026-06-29.","x":800,"y":110,"width":420,"height":120,"color":"3"},
		{"id":"ops-kill","type":"text","text":"**Kill criteria A1-A5**\n`paper_trading_kill_criteria.ts`\nA4 = mr/trend corr > +0.7 · A5 = 30d cumP&L < −20%.","x":800,"y":250,"width":420,"height":140,"color":"3"},
		{"id":"ops-brief","type":"text","text":"**Operator brief + audit**\n`operator_brief.ts` (morning markdown)\n`audit_positions.ts` (allowlist violation check)\n`_paper_trading_review.ts` (per-cell unrealized)","x":800,"y":410,"width":420,"height":140,"color":"3"},
		{"id":"lyr-ui","type":"text","text":"## 🖥️ Dashboard UI","x":1350,"y":-440,"width":420,"height":50,"color":"6"},
		{"id":"ui-app","type":"text","text":"**React + Vite** — `src/App.tsx`\nRoutes: `/#/regime` · `/#/paper` · `/#/cluster` · `/#/validator`","x":1350,"y":-360,"width":420,"height":120,"color":"6"},
		{"id":"ui-regime","type":"text","text":"**RegimeApp**\nToday's regime banner · category panels ·\ndistribution vs ADR_038_BASELINE.","x":1350,"y":-220,"width":420,"height":120,"color":"6"},
