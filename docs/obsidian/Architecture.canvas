{
	"nodes":[
		{"id":"title","type":"text","text":"# SignalForge — Architecture\n\nLeft → right: data flows from external sources → ClickHouse → backtest + regime classification → trade-execution pipeline → daemon → paper trading → dashboard.\n\nOpen [[_Index]] for the Mermaid version with full edges.","x":-1400,"y":-700,"width":700,"height":200,"color":"6"},
		{"id":"lyr-src","type":"text","text":"## 🌐 External data sources","x":-1400,"y":-440,"width":420,"height":50,"color":"6"},
