		{"id":"src-fred","type":"text","text":"**FRED**\nT10Y2Y yield curve.\n`fred_ingest.py` · `series_id='T10Y2Y'`","x":-1400,"y":-220,"width":420,"height":120,"color":"6"},
		{"id":"src-cboe","type":"text","text":"**CBOE**\nP/C ratio archive (2003-2019, free CSVs).\n2019-present gated by DataShop.\n`cboe_putcall_ingest.py`","x":-1400,"y":-80,"width":420,"height":140,"color":"6"},
		{"id":"src-stooq","type":"text","text":"**Stooq** *(breadth — gated)*\n`^A50R` blocked by captcha-apikey.\n`STOOQ_APIKEY` env var required.","x":-1400,"y":80,"width":420,"height":120,"color":"1"},
		{"id":"src-wiki","type":"text","text":"**Wikipedia (fja05680)**\nS&P 500 historical constituents (PIT).\n`macro_refresh_constituents.py`","x":-1400,"y":220,"width":420,"height":120,"color":"6"},
