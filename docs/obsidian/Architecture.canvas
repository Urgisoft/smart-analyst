		{"id":"ch-candles","type":"text","text":"**candles · daily_candles**\nOHLCV bars, multi-interval.\nFINAL via ReplacingMergeTree.","x":-850,"y":-360,"width":420,"height":120,"color":"5"},
		{"id":"ch-macro","type":"text","text":"**macro_indicators_fred · macro_indicators_cboe**\nMacro series, FINAL.","x":-850,"y":-220,"width":420,"height":100,"color":"5"},
		{"id":"ch-breadth","type":"text","text":"**macro_breadth**\nS&P 500 % above MA200, advance/decline.","x":-850,"y":-100,"width":420,"height":100,"color":"5"},
